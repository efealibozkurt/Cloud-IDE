{
  "name": "cloud-ide",
  "productName": "Cloud IDE",
  "version": "0.1.0",
  "description": "Gömülü sistemler için modern AI destekli Cloud IDE (Arduino uyumlu)",
  "main": "./out/main/index.js",
  "author": "Efe Ali Bozkurt <iletisim@efealibozkurt.com.tr>",
  "license": "GPL-3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/efealibozkurt/Cloud-IDE.git"
  },
  "homepage": "https://github.com/efealibozkurt/Cloud-IDE#readme",
  "bugs": {
    "url": "https://github.com/efealibozkurt/Cloud-IDE/issues"
  },
  "keywords": [
    "cloud-ide",
    "dret-ide",
    "arduino",
    "electron",
    "embedded-systems",
    "iot",
    "ai",
    "rag",
    "serialport"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "build:setup": "npm run build && electron-builder --win nsis",
    "build:portable": "npm run build && electron-builder --win portable",
    "build:dir": "npm run build && electron-builder --dir",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:logos": "node scripts/generate-hd-logos.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-store": "^8.2.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "monaco-editor": "^0.52.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.32.6",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
